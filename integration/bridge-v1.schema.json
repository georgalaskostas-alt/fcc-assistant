{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.fcc-assistant/bridge-v1.schema.json",
  "title": "FCC Assistant TRAVIS Bridge v1",
  "type": "object",
  "required": ["contract_version", "service", "mode", "read_only", "external_ai", "plant_write_access", "capabilities", "site"],
  "properties": {
    "contract_version": { "const": "1.0-draft" },
    "service": { "const": "fcc-assistant-backend" },
    "mode": { "const": "local" },
    "read_only": { "const": true },
    "external_ai": { "const": false },
    "plant_write_access": { "const": false },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "site": {
      "type": "object",
      "required": ["name", "unit_count", "units"],
      "properties": {
        "name": { "type": "string" },
        "unit_count": { "type": "integer", "minimum": 1 },
        "units": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
