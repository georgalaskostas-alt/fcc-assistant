# FCC Assistant local configuration
# Never commit real credentials, internal plant URLs, or real tag mappings.

FCC_APP_ENV=development
FCC_PI_WEB_API_URL=
FCC_PI_VERIFY_TLS=true
FCC_PI_TIMEOUT_SECONDS=15
FCC_TAG_CONFIG_PATH=config/fcc-tags.local.json

# Local AI runtime (Ollama-compatible). Runs on this laptop; no cloud AI API.
FCC_LOCAL_AI_URL=http://127.0.0.1:11434
FCC_LOCAL_AI_MODEL=
FCC_LOCAL_AI_TIMEOUT_SECONDS=120
