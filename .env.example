# FCC Assistant local configuration
# Never commit real credentials, internal plant URLs, or real tag mappings.

FCC_APP_ENV=development
FCC_PI_WEB_API_URL=
FCC_PI_VERIFY_TLS=true
FCC_PI_TIMEOUT_SECONDS=15
FCC_TAG_CONFIG_PATH=config/fcc-tags.local.json

# Optional TRAVIS bridge. Standalone mode keeps this disabled by default.
FCC_TRAVIS_AI_URL=http://127.0.0.1:8765
FCC_TRAVIS_AI_TIMEOUT_SECONDS=120
FCC_PREFER_TRAVIS_AI=false

# Embedded local AI. No Ollama and no external AI API.
FCC_LOCAL_AI_RUNTIME=llama_cpp
FCC_LOCAL_AI_URL=http://127.0.0.1:8081
FCC_LOCAL_AI_MODEL_NAME=embedded-local-model
FCC_LOCAL_AI_BINARY_PATH=runtime/bin/llama-server
FCC_LOCAL_AI_MODEL_PATH=models/default.gguf
FCC_LOCAL_AI_CONTEXT_SIZE=4096
FCC_LOCAL_AI_THREADS=0
FCC_LOCAL_AI_TIMEOUT_SECONDS=180
