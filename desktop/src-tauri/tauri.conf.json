{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FCC Assistant",
  "version": "0.1.0",
  "identifier": "com.fccassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FCC Assistant",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/fcc-backend"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
